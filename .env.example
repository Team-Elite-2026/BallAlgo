# Copy to .env and fill in real values. The .env file is gitignored.
# These are read by foxglove_sim/sidecar.py when foxglove_upload = true
# in foxglove_sim/foxglove.conf, to upload each finished MCAP to the
# Foxglove Data Platform for replay from anywhere.
FOXGLOVE_API_KEY=fox_sk_your_api_key_here
FOXGLOVE_DEVICE_ID=dev_your_device_id_here
